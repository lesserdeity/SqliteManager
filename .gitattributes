# Store text files with LF in the repository and check them out with CRLF.
# This is a Windows-only project, so CRLF in the working copy matches Visual Studio.
* text=auto eol=crlf

# Binary files: never change line endings or diff as text.
*.xls   binary
*.xlsx  binary
*.db    binary
*.sqlite binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
